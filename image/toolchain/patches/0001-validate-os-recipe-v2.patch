diff --git a/src/commands/validate/symbi_recipe_v2.rs b/src/commands/validate/symbi_recipe_v2.rs
new file mode 100644
--- /dev/null
+++ b/src/commands/validate/symbi_recipe_v2.rs
@@ -0,0 +1,56 @@
+//! Downstream Symbi OS recipe profile, not general-purpose recipe-v2 support.
+//!
+//! Every accepted field is validated against an embedded, closed schema before
+//! the upstream typed parser sees it. Imports, stages and external modules are
+//! deliberately unsupported. This path never retrieves a mutable schema.
+use std::path::Path;
+
+use blue_build_recipe::{Recipe, RecipeGetters};
+use miette::{Context, IntoDiagnostic, Result, bail, miette};
+use serde_json::Value;
+
+pub(super) fn validate_if_v2(path: &Path, text: &str) -> Result<bool> {
+    let instance: Value = serde_yaml::from_str(text)
+        .into_diagnostic()
+        .wrap_err_with(|| format!("Recipe {} failed to validate", path.display()))?;
+    // Preserve the existing v1 route. An absent version on a v2-shaped input
+    // must fail this profile instead of being mistaken for a legacy recipe.
+    let has_v2_fields = ["base", "metadata", "spec"]
+        .iter()
+        .any(|field| instance.get(field).is_some());
+    if !has_v2_fields
+        && matches!(
+            instance.get("version").and_then(Value::as_u64),
+            None | Some(1)
+        )
+    {
+        return Ok(false);
+    }
+
+    let validate = || -> Result<()> {
+        let schema: Value = serde_json::from_str(include_str!("symbi_recipe_v2.json"))
+            .into_diagnostic()
+            .wrap_err("Invalid embedded Symbi OS recipe schema")?;
+        let validator = jsonschema::options()
+            .build(&schema)
+            .map_err(|error| miette!("Cannot compile embedded recipe schema: {error}"))?;
+        let errors: Vec<String> = validator
+            .iter_errors(&instance)
+            .take(16)
+            .map(|error| format!("{}: {error}", error.instance_path))
+            .collect();
+        if !errors.is_empty() {
+            bail!("Symbi OS recipe v2 profile: {}", errors.join("\n"));
+        }
+        // Check actual upstream deserialization and OCI-reference semantics as
+        // well as the schema; a schema-only success cannot hide an incompatibility.
+        let recipe: Recipe = serde_yaml::from_str(text).into_diagnostic()?;
+        if !matches!(&recipe, Recipe::V2(_)) {
+            bail!("Expected the upstream v2 parser");
+        }
+        recipe.base_image_ref()?;
+        Ok(())
+    };
+    validate().wrap_err_with(|| format!("Recipe {} failed to validate", path.display()))?;
+    Ok(true)
+}
