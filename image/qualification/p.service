[Unit]
Description=Prepare the disposable non-root qualification account
ConditionPathExists=!/etc/initrd-release
Requires=m.service
After=m.service
Before=q.service l.service
OnFailure=poweroff.target

[Service]
Type=oneshot
RemainAfterExit=yes
ImportCredential=symbi-sysusers.conf
ImportCredential=symbi-prepare.py
StateDirectory=symbi-qualification
StateDirectoryMode=0755
ExecStart=/usr/bin/python3 %d/symbi-prepare.py %d/symbi-sysusers.conf
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_SETGID CAP_SETUID
AmbientCapabilities=
PrivateDevices=yes
PrivateNetwork=yes
PrivatePIDs=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc /var/lib/systemd /var/lib/symbi-qualification
MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
TasksMax=32
TimeoutStartSec=90
TimeoutStopSec=15
StandardOutput=journal+console
StandardError=journal+console
