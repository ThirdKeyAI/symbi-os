[Unit]
Description=Verify the fixed authenticated hosted qualification source mount
ConditionPathExists=!/etc/initrd-release
Wants=systemd-udevd.service
Wants=d.service
After=systemd-udevd.service
After=d.service
RequiresMountsFor=/run/symbi-qualification/source
Before=p.service q.service l.service
OnFailure=poweroff.target

[Service]
Type=oneshot
RemainAfterExit=yes
ImportCredential=symbi-source-mount.py
ImportCredential=symbi_mountinfo.py
ImportCredential=symbi-expected.json
ExecStart=/usr/bin/python3 %d/symbi-source-mount.py %d/symbi-expected.json
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LANG=C.UTF-8
RuntimeDirectory=symbi-qualification
RuntimeDirectoryMode=0755
UMask=0022
User=root
Group=root
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateNetwork=yes
PrivatePIDs=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/symbi-qualification
MemoryMax=128M
MemorySwapMax=0
CPUQuota=25%
TasksMax=16
TimeoutStartSec=90
TimeoutStopSec=15
StandardOutput=journal+console
StandardError=journal+console
