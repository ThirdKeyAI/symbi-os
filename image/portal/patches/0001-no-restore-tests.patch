+// Symbi OS must never emit a remembered choice, even if a caller asks for it.
+static bool testFreshConsentFormatting() {
+    bool success = true;
+    const std::vector<std::pair<SSelection, std::string>> CASES = {
+        {SSelection{.type = SELECTION_OUTPUT, .output = "DP-1"}, "[SELECTION]/screen:DP-1\n"},
+        {SSelection{.type = SELECTION_WINDOW, .windowID = UINT32_MAX}, "[SELECTION]/window:4294967295\n"},
+        {SSelection{.type = SELECTION_WORKSPACE, .workspaceID = UINT64_MAX}, "[SELECTION]/workspace-id:18446744073709551615\n"},
+        {SSelection{.type = SELECTION_REGION, .output = "DP-1", .x = 20, .y = 30, .width = 800, .height = 600},
+         "[SELECTION]/region:DP-1@20,30,800,600\n"},
+    };
+    for (const auto& [selection, expected] : CASES) {
+        for (const bool requestedPersistence : {false, true}) {
+            success &= expect(formatSelection(selection, requestedPersistence) == expected,
+                              "Symbi OS: persistent choice emitted or fresh selection changed");
+        }
+    }
+    for (const bool requestedPersistence : {false, true}) {
+        success &= expect(formatSelection(SSelection{.type = SELECTION_NONE}, requestedPersistence).empty(),
+                          "Symbi OS: cancellation emitted a selection");
+        success &= expect(formatSelection(SSelection{.type = SELECTION_WORKSPACE}, requestedPersistence).empty(),
+                          "Symbi OS: invalid workspace emitted a selection");
+    }
+    return success;
+}
