@@ -0,0 +1,38 @@
+package providers
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+// This OS ships one built-in application provider. User configuration and
+// ELEPHANT_PROVIDER_DIR/ELEPHANT_DEV cannot introduce native menu extensions.
+const symbiProviderDirectory = "/usr/lib/symbi/elephant/providers"
+
+func symbiProviderAllowed(path string) error {
+	if path != symbiProviderDirectory+"/desktopapplications.so" {
+		return fmt.Errorf("only the packaged desktopapplications provider is enabled")
+	}
+	for current := path; ; current = filepath.Dir(current) {
+		info, err := os.Lstat(current)
+		if err != nil {
+			return err
+		}
+		owner, ok := info.Sys().(*syscall.Stat_t)
+		if !ok || owner.Uid != 0 || info.Mode().Perm()&0022 != 0 || info.Mode()&os.ModeSymlink != 0 {
+			return fmt.Errorf("provider path must be root-owned, non-writable by others and contain no links: %s", current)
+		}
+		if current == path {
+			if !info.Mode().IsRegular() {
+				return fmt.Errorf("provider must be a regular file")
+			}
+		} else if !info.IsDir() {
+			return fmt.Errorf("provider parent must be a directory")
+		}
+		if current == "/" {
+			return nil
+		}
+	}
+}
