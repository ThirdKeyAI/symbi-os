[Unit]
Description=Probe the dedicated SELinux bootc transition for the disposable hosted VM
ConditionPathExists=!/etc/initrd-release
After=local-fs.target
Before=o.service
OnFailure=f.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
ExecStartPre=-/usr/bin/echo SYMBI_UPDATE_LIFECYCLE=b-enter
ExecStartPre=/usr/bin/cat /proc/self/attr/current
ExecStart=/usr/libexec/symbi-atomic-update --probe
ExecStartPost=-/usr/bin/echo SYMBI_UPDATE_LIFECYCLE=b-success
UMask=0077
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
MemoryMax=64M
MemorySwapMax=0
CPUQuota=25%
TasksMax=16
TimeoutStartSec=30
TimeoutStopSec=15
StandardOutput=journal+console
StandardError=journal+console
