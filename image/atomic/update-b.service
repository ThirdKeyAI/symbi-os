[Unit]
Description=Prepare the fixed SELinux bootc launcher for the disposable hosted VM
ConditionPathExists=!/etc/initrd-release
ConditionPathExists=!/run/symbi-update-bootc
ConditionPathExists=!/run/symbi-update-bootc.new
After=local-fs.target
Before=o.service
OnFailure=poweroff.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
SELinuxContext=system_u:system_r:install_t:s0
ExecStart=/usr/bin/install --owner=0 --group=0 --mode=0700 /usr/bin/bootc /run/symbi-update-bootc.new
ExecStart=/usr/bin/chcon --reference=/usr/bin/ostree /run/symbi-update-bootc.new
ExecStart=/usr/bin/mv /run/symbi-update-bootc.new /run/symbi-update-bootc
ExecStopPost=/usr/bin/rm --force /run/symbi-update-bootc.new
UMask=0077
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_MAC_ADMIN
AmbientCapabilities=
ProtectHome=yes
MemoryMax=64M
MemorySwapMax=0
CPUQuota=25%
TasksMax=16
TimeoutStartSec=30
TimeoutStopSec=15
StandardOutput=journal+console
StandardError=journal+console
