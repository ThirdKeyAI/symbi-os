[Unit]
Description=Fixed bootc status collector for the disposable hosted VM
ConditionPathExists=!/etc/initrd-release
After=local-fs.target
Before=o.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/bootc status --json
StandardOutput=truncate:/run/symbi-atomic-status.json
StandardError=journal+console
Environment=LANG=C.UTF-8
UMask=0077
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateMounts=yes
PrivateTmp=yes
MemoryMax=256M
MemorySwapMax=0
CPUQuota=50%
TasksMax=32
TimeoutStartSec=90
TimeoutStopSec=15
