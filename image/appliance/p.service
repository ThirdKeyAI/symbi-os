[Unit]
Description=HIGHLY EXPERIMENTAL appliance fixture provisioner
ConditionPathExists=!/etc/initrd-release
Before=display-manager.service sddm.service upgrade-on-boot.service
After=local-fs.target systemd-udev-trigger.service
OnFailure=poweroff.target

[Service]
Type=oneshot
RemainAfterExit=yes
ImportCredential=symbi-provision.py
ImportCredential=symbi-expected.json
ExecStart=/usr/bin/python3 %d/symbi-provision.py %d/symbi-expected.json
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LANG=C.UTF-8
UMask=0077
PrivateTmp=yes
MemoryMax=256M
MemorySwapMax=0
CPUQuota=100%
TasksMax=64
TimeoutStartSec=300
TimeoutStopSec=15
StandardOutput=journal+console
StandardError=journal+console
